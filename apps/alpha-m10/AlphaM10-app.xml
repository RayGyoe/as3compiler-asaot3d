<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<application xmlns="http://ns.adobe.com/air/application/51.1">

    <!-- M10 acceptance demo: tone mapping + alpha blending + alpha test.
         Same envelope as the other asaot3d demos (extendedDesktop + direct +
         depth/stencil). -->

    <id>com.asaot.three.example.AlphaM10</id>
    <filename>AlphaM10</filename>
    <name>AlphaM10</name>
    <versionNumber>0.0.1</versionNumber>

    <supportedProfiles>extendedDesktop</supportedProfiles>

    <initialWindow>
        <content>build/AlphaM10.swf</content>
        <renderMode>direct</renderMode>
        <depthAndStencil>true</depthAndStencil>
        <width>760</width>
        <height>420</height>
        <visible>true</visible>
        <requestedDisplayResolution>high</requestedDisplayResolution>
    </initialWindow>

</application>
