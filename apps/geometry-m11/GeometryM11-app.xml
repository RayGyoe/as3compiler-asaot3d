<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<application xmlns="http://ns.adobe.com/air/application/51.1">

    <!-- M11 acceptance demo: geometry family (cylinder/cone/torus/circle/ring/
         lathe/tube/edges) plus frustum culling. Same envelope as the other
         asaot3d demos (extendedDesktop + direct + depth/stencil). -->

    <id>com.asaot.three.example.GeometryM11</id>
    <filename>GeometryM11</filename>
    <name>GeometryM11</name>
    <versionNumber>0.0.1</versionNumber>

    <supportedProfiles>extendedDesktop</supportedProfiles>

    <initialWindow>
        <content>build/GeometryM11.swf</content>
        <renderMode>direct</renderMode>
        <depthAndStencil>true</depthAndStencil>
        <width>720</width>
        <height>360</height>
        <visible>true</visible>
        <requestedDisplayResolution>high</requestedDisplayResolution>
    </initialWindow>

</application>
